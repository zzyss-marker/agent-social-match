# App
APP_NAME="Agent Social Match"
APP_VERSION="1.0.0"
DEBUG=false

# Database
DATABASE_URL="sqlite+aiosqlite:///./data/matchmaking.db"

# CORS
CORS_ORIGINS=["http://localhost:8000","http://127.0.0.1:8000"]

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console

# LLM API
# Example: OpenAI-compatible endpoint base URL (no trailing slash needed)
LLM_BASE_URL="https://api.deepseek.com/v1"
# Fill your real key in local .env, do NOT commit it
LLM_API_KEY=""
LLM_MODEL="deepseek-chat"
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.7

# Discovery / Recommendation
DISCOVERY_CHAT_MIN_PER_RUN=1
DISCOVERY_CHAT_MAX_PER_RUN=3
DISCOVERY_CANDIDATE_POOL_LIMIT=80
DISCOVERY_REC_COOLDOWN_HOURS=24
DISCOVERY_MIN_MATCH_SCORE=68
DISCOVERY_MIN_CONFIDENCE=55
DISCOVERY_MAX_PENDING_RECOMMENDATIONS=20

# Dashboard scalability
COMMUNITY_PAGE_SIZE=24
COMMUNITY_MAX_PAGE_SIZE=60
DASHBOARD_RECOMMENDATION_PAGE_SIZE=4
DASHBOARD_DISCOVERY_PAGE_SIZE=4
DASHBOARD_MAX_PANEL_PAGE_SIZE=20

# Session
SESSION_SECRET="replace-with-a-random-long-secret"

# Auth / Email Verification
AUTH_PASSWORD_MIN_LENGTH=8
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_HOURLY_LIMIT=5
EMAIL_CODE_DAILY_LIMIT=20
EMAIL_CODE_SECRET="replace-with-a-random-long-secret"

# SMTP (for registration email code)
SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SENDER=""
SMTP_USE_SSL=true
SMTP_USE_STARTTLS=false
